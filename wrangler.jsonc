{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Static build (`nuxt generate`) served by Cloudflare's asset server.
  // Top level deploys the main branch to staging; the `release` environment
  // deploys to the live domain. See the deploy scripts in package.json.
  "name": "namai",
  "compatibility_date": "2025-07-15",
  "assets": {
    "directory": ".output/public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "staging.justzhu.com", "custom_domain": true }
  ],

  "env": {
    "release": {
      "name": "namai-release",
      "assets": {
        "directory": ".output/public",
        "not_found_handling": "404-page"
      },
      // www.justzhu.com is not here yet: it still has externally managed DNS
      // records, and Cloudflare refuses to attach a Worker custom domain over
      // them. Clear that record, then add:
      //   { "pattern": "www.justzhu.com", "custom_domain": true }
      "routes": [
        { "pattern": "justzhu.com", "custom_domain": true }
      ]
    }
  }
}
